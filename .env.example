# Скопируй в .env и заполни своими значениями.  .env в git не коммитится —
# реальные токены сюда, в .env.example, класть не надо (шаблон коммитится).

# --- API игры ---
# Демо-сервер (регистрация не нужна): https://dapi.stalcraft.net
# Боевой сервер: https://eapi.stalcraft.net
STALCRAFT_API_BASE=https://dapi.stalcraft.net
# Демо-пара из документации (auth.html, Secret Based Authentication) — общая на
# всех, кто тестирует демо-API, менять не обязательно, пока сидишь на dapi.
# На проде — свои client_id/client_secret после одобрения заявки на eapi.
STALCRAFT_CLIENT_ID=1
STALCRAFT_CLIENT_SECRET=E98cm6J9NNjTQopph0c2eIXNKafg4R1Cjz0TZh2D
REGIONS=EU
# Пол между опросами одного региона, секунды. Реальный интервал в main.py
# адаптивный — подстраивается под X-RateLimit-* от сервера, но быстрее этого
# порога не разгоняется.
MIN_POLL_INTERVAL=2
# Тихий старт: подію старіше цього (секунди) не шлемо в Telegram, тільки
# записуємо в стан. Інакше при кожному запуску бот сповіщав би про давно
# минулий викид, а перезапуск під час активного — анонсував би його вдруге.
ANNOUNCE_MAX_AGE=900
# Через скільки секунд після кінця викиду рахувати топ-10 проданих
# артефактів (час на активний збір і продаж). 1800 = 30 хвилин.
TOP_SALES_DELAY=1800

# --- Telegram ---
# Не обязательны для запуска: без них бот работает в режиме "печатает в консоль".
TG_TOKEN=123456:PUT-YOUR-BOTFATHER-TOKEN
# Куда слать: id канала/группы (например -1001234567890) или @имя_канала.
# Через запятую можно несколько. Это НЕ юзернейм бота.
TG_CHAT_IDS=@my_channel

# --- Прочее ---
STATE_PATH=data/state.json
